# Generated by the notebooks (recreated by running take_packet / process_packet walkthroughs)
rehearsal/
processed/

# Raw data: too large for GitHub, keep on a lab disk
data/
!docs/slides/data/

# Published papers and other PDFs in docs/ (not ours to redistribute; keep the .tex notes)
docs/*.pdf

# Regenerable figures; keep the figures used by the context documents
plots/
*.png
!docs/context/figures/*.png
!docs/overleaf_*/figures/*.png
!docs/slides/figures/*.png

# Stray local output
/test

# Python / Jupyter / macOS
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# Private correspondence
docs/*email*

# Python environment for the ML models (requirements-ml.txt)
.venv/

# Compiled Overleaf output (rebuild from the .tex)
docs/overleaf_*/*.pdf
docs/overleaf_*/*.log

# Packet manifests written by make_manual_manifest.py (data-specific)
manifests/

# Level 1: regenerated test data and the notebook demo output
lvl1/test_data/
lvl1/demo/
